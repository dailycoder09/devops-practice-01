# Safety net for the whole project. Each service folder also has its own .gitignore.

# macOS and editors
.DS_Store
.idea/
.vscode/
*.iml
*.swp
*~

# Secrets and local settings: never commit these
.env
.env.*
*.pem
*.key
application-local.yml
application-local.properties
# Your own filled-in copy of a user data script (it holds passwords): name it like  deploy/aws/my-user-data.local.sh
*.local.sh

# Local run output (created when the apps run on this machine)
logs/
*.log
data/
*.db
*.trace.db

# Build output and installed dependencies
target/
node_modules/
dist/
*.jar
# The saved image file for AWS (deploy/local/build-images.sh): large, goes to S3, never to git
deploy/local/out/
*.tar.gz

# Tool folders that are not part of the project
.remember/
