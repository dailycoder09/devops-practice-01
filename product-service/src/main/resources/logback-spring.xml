<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging set-up (the same file in every Java service; only the name comes from spring.application.name).

  - Profile "dev":   readable text on the console, with the trace id and the user.
  - Other profiles:  one JSON object per line on stdout (containers and CloudWatch read stdout).
  - All profiles:    the same JSON lines in a rolling file, ${LOG_PATH:-logs}/<service>.json.log
                     (daily and every 10 MB, 14 days, 500 MB at most).
  - Both are written through async appenders (queue 1024, a line is never discarded).

  JSON fields: timestamp (ISO-8601, UTC), level, service, profile, logger, thread, message, stack_trace (one field),
  every MDC key (traceId, spanId, userId, userEmail, userRole, clientIp) and every structured argument
  (event, httpStatus, ...) as a top-level field.

  Never log passwords, tokens, the Authorization header, request bodies or query strings (see the README).
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="SERVICE_NAME" source="spring.application.name" defaultValue="product-service"/>
    <springProperty scope="context" name="PROFILE_NAME" source="spring.profiles.active" defaultValue="default"/>
    <property name="LOG_DIRECTORY" value="${LOG_PATH:-logs}"/>
    <property name="LOG_FILE_BASE" value="${LOG_DIRECTORY}/${SERVICE_NAME}"/>

    <!-- Console: readable text in dev, JSON everywhere else -->
    <springProfile name="dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%X{traceId:-}] [user=%X{userId:-} ip=%X{clientIp:-}] %logger{25} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>
    <springProfile name="!dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <timeZone>UTC</timeZone>
                <includeContext>false</includeContext>
                <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
                <fieldNames>
                    <timestamp>timestamp</timestamp>
                    <version>[ignore]</version>
                    <levelValue>[ignore]</levelValue>
                    <logger>logger</logger>
                    <thread>thread</thread>
                    <stackTrace>stack_trace</stackTrace>
                </fieldNames>
                <customFields>{"service":"${SERVICE_NAME}","profile":"${PROFILE_NAME}"}</customFields>
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <maxDepthPerThrowable>40</maxDepthPerThrowable>
                    <maxLength>32768</maxLength>
                    <rootCauseFirst>true</rootCauseFirst>
                </throwableConverter>
            </encoder>
        </appender>
    </springProfile>

    <!-- Rolling JSON file, in every profile -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE_BASE}.json.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE_BASE}.json.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timeZone>UTC</timeZone>
            <includeContext>false</includeContext>
            <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
                <logger>logger</logger>
                <thread>thread</thread>
                <stackTrace>stack_trace</stackTrace>
            </fieldNames>
            <customFields>{"service":"${SERVICE_NAME}","profile":"${PROFILE_NAME}"}</customFields>
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>40</maxDepthPerThrowable>
                <maxLength>32768</maxLength>
                    <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>

    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="CONSOLE"/>
    </appender>

    <appender name="ASYNC_JSON_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="JSON_FILE"/>
    </appender>

    <!-- Levels. application.yml (logging.level.*) is applied on top of these. -->
    <logger name="com.microservices" level="INFO"/>
    <springProfile name="dev">
        <logger name="com.microservices" level="DEBUG"/>
    </springProfile>

    <!-- Audit events: the same appenders as everything else (through the root logger), always at least INFO -->
    <logger name="audit" level="INFO"/>

    <logger name="org.hibernate" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="org.flywaydb" level="INFO"/>
    <logger name="org.springframework" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="ASYNC_CONSOLE"/>
        <appender-ref ref="ASYNC_JSON_FILE"/>
    </root>
</configuration>
