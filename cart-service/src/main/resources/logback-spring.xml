<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging for cart-service. The same file is used by every Java service of the project; only the service
  name differs, and it is read from spring.application.name.

  What it writes:
  - A JSON file, always: ${LOG_PATH:-logs}/<service>.json.log (new file every day and every 10 MB, kept 14 days,
    at most 500 MB in total). One line per event, real JSON (quotes and line breaks are escaped).
  - stdout: JSON outside the dev profile (containers and CloudWatch read stdout), readable text in dev.
  - Both go through an async appender (queue of 1024 lines, nothing is ever dropped).

  JSON fields: timestamp (ISO-8601, UTC), level, service, profile, logger (short), thread, message, stack_trace,
  every MDC key (traceId, spanId, userId, userEmail, userRole, clientIp) and every structured argument
  (event, httpMethod, ...).
-->
<configuration>

    <springProperty scope="local" name="SERVICE_NAME" source="spring.application.name" defaultValue="cart-service"/>
    <springProperty scope="local" name="PROFILE_NAME" source="spring.profiles.active" defaultValue="default"/>
    <property name="LOG_DIR" value="${LOG_PATH:-logs}"/>

    <!-- stdout in the dev profile: readable text with the trace id and the caller -->
    <springProfile name="dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%X{traceId:-}] [user=%X{userId:-} ip=%X{clientIp:-}] %logger{25} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>

    <!-- stdout in every other profile: JSON -->
    <springProfile name="!dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <timeZone>UTC</timeZone>
                <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</timestampPattern>
                <fieldNames>
                    <timestamp>timestamp</timestamp>
                    <version>[ignore]</version>
                    <levelValue>[ignore]</levelValue>
                    <logger>logger</logger>
                    <thread>thread</thread>
                    <message>message</message>
                    <stackTrace>stack_trace</stackTrace>
                </fieldNames>
                <shortenedLoggerNameLength>25</shortenedLoggerNameLength>
                <customFields>{"service":"${SERVICE_NAME}","profile":"${PROFILE_NAME}"}</customFields>
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <maxDepthPerThrowable>40</maxDepthPerThrowable>
                    <maxLength>16384</maxLength>
                    <rootCauseFirst>true</rootCauseFirst>
                </throwableConverter>
            </encoder>
        </appender>
    </springProfile>

    <!-- The JSON file, in every profile -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${SERVICE_NAME}.json.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${SERVICE_NAME}.%d{yyyy-MM-dd}.%i.json.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timeZone>UTC</timeZone>
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</timestampPattern>
            <fieldNames>
                <timestamp>timestamp</timestamp>
                <version>[ignore]</version>
                <levelValue>[ignore]</levelValue>
                <logger>logger</logger>
                <thread>thread</thread>
                <message>message</message>
                <stackTrace>stack_trace</stackTrace>
            </fieldNames>
            <shortenedLoggerNameLength>25</shortenedLoggerNameLength>
            <customFields>{"service":"${SERVICE_NAME}","profile":"${PROFILE_NAME}"}</customFields>
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>40</maxDepthPerThrowable>
                <maxLength>16384</maxLength>
                <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
        </encoder>
    </appender>

    <!-- Async: the request thread does not wait for the disk. Never drop a line (discardingThreshold 0). -->
    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <maxFlushTime>3000</maxFlushTime>
        <appender-ref ref="CONSOLE"/>
    </appender>

    <appender name="ASYNC_JSON_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <maxFlushTime>3000</maxFlushTime>
        <appender-ref ref="JSON_FILE"/>
    </appender>

    <!-- Our own code -->
    <logger name="com.microservices" level="INFO"/>

    <!-- Audit events (who did what): the same appenders as everything else, through the root logger -->
    <logger name="audit" level="INFO"/>

    <!-- Spring and the others -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>
    <logger name="org.springframework.boot.actuate" level="INFO"/>
    <logger name="org.hibernate" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>
    <logger name="org.flywaydb" level="INFO"/>

    <!-- Development: more detail. SQL statements are shown, but never with their parameter values. -->
    <springProfile name="dev">
        <logger name="com.microservices" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="INFO"/>
    </springProfile>

    <!-- Production: less from Spring -->
    <springProfile name="prod">
        <logger name="org.springframework" level="WARN"/>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="ASYNC_CONSOLE"/>
        <appender-ref ref="ASYNC_JSON_FILE"/>
    </root>

</configuration>
